@namespace LuckerParty.UI
@inherits PanelComponent
@using System
@implements NetworkManager.IClientEvent

<root class="clover-background enable-input full-screen">
	<div id="lobby-container">
		<div class="title">Lobby</div>
		<div class="divider"></div>
		<div id="player-list">
			@foreach ( var connection in _connections )
			{
				<div class="player-item">@connection.DisplayName</div>
			}
			@for ( var i = 0; i < 5; i++ )
			{
				<div class="player-item debug">Debug Player @i</div>
			}
		</div>
		<div id="options">
			<button onclick="@StartGame">Start Game</button>
		</div>
	</div>
</root>

@code
{
	private IEnumerable<Connection> _connections = Connection.All;

	protected override void OnStart()
	{
		base.OnStart();
		UpdateClients();
	}
	
	[Rpc.Broadcast]
	void NetworkManager.IClientEvent.OnConnected( Client client )
	{
		UpdateClients();
	}
	
	[Rpc.Broadcast]
	void NetworkManager.IClientEvent.OnDisconnected( Client client )
	{
		UpdateClients();
	}
	
	private void UpdateClients()
	{
		_connections = Connection.All.OrderBy(connection => connection.ConnectionTime  );
	}

	private void StartGame()
	{
		Enabled = false;
	}

	/// <summary>
	///     the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash()
	{
		return HashCode.Combine( _connections );
	}
}
