@namespace LuckerParty.UI
@using System
@inherits PanelComponent

<root class="clover-background enable-input full-screen">
	<div id="lobby-container">
		<div class="title">Lobby</div>
		<div id="player-list">
			@foreach ( var client in Clients )
			{
				<div class="player-item">
					<div class="player-name">@client.Name</div>
					@if ( LobbyManager.IsReady( client ) )
					{
						<div class="ready">Ready</div>
					}
					else
					{
						<div class="not-ready">Not Ready</div>
					}
				</div>
			}
		</div>
		<div id="options">
			@if ( Networking.IsHost )
			{
				<button id="start-game" onclick="@StartGame">Start Game</button>
			}
			<button id="toggle-ready" onclick="@ToggleReady">@( IsReady ? "Unready" : "Ready" )</button>
		</div>
	</div>
</root>

@code
{
	// now that we fixed the client connection assignment
	// we should reference connections via the Client component
	// rather than the Connection.All
	private LobbyManager LobbyManager => Game.ActiveScene.Components.GetInDescendants<LobbyManager>();
	private IEnumerable<Client> Clients => Game.ActiveScene.Components.GetInDescendants<NetworkManager>().Clients.OrderBy( client => client.ConnectionTime );
	private bool IsReady => LobbyManager.IsReady( Client.Local );

	// TODO: Network
	private void StartGame()
	{
		var gameManager = Scene.GetAllComponents<GameManager>().First();
		gameManager.Transition( GameManager.State.Round );
	}

	private void ToggleReady()
	{
		var isReady = LobbyManager.IsReady( Client.Local );
		LobbyManager.SetIsReady( Client.Local, !isReady );
	}

	/// <summary>
	///     the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash()
	{
		return HashCode.Combine( Clients, IsReady );
	}
}
