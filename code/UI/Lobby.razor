@namespace LuckerParty.UI
@using System
@inherits PanelComponent

<root class="clover-background enable-input full-screen">
	<div id="lobby-container">
		<div class="title">Lobby</div>
		<div id="client-list-container">
			<div class="client-type-container">
				<div class="client-type">Players (@( PlayerClients.Count() ))</div>
				@if ( Client.Local.CurrentType != Client.Type.Player )
				{
					<button class="client-type-join" onclick="@BecomePlayer">Join</button>
				}
			</div>

			<div class="client-list">
				@foreach ( var playerClient in PlayerClients )
				{
					<div class="client-item">
						<div>@playerClient.Name</div>
						@if ( LobbyManager.IsReady( playerClient ) )
						{
							<div class="ready">Ready</div>
						}
						else
						{
							<div class="not-ready">Not Ready</div>
						}
					</div>
				}
			</div>
			<div class="client-type-container">
				<div class="client-type">Spectators (@( SpectatorClients.Count() ))</div>
				@if ( Client.Local.CurrentType != Client.Type.Spectator )
				{
					<button class="client-type-join" onclick="@BecomeSpectator">Join</button>
				}
			</div>
			<div class="client-list">
				@foreach ( var spectatorClient in SpectatorClients )
				{
					<div class="client-item">
						<div>@spectatorClient.Name</div>
						@if ( LobbyManager.IsReady( spectatorClient ) )
						{
							<div class="ready">Ready</div>
						}
						else
						{
							<div class="not-ready">Not Ready</div>
						}
					</div>
				}
			</div>
		</div>
		<div id="options">
			@if ( Networking.IsHost )
			{
				<button id="start-game" onclick="@StartGame">Start Game</button>
			}
			<button id="toggle-ready" onclick="@ToggleReady">@( IsReady ? "Unready" : "Ready" )</button>
		</div>
	</div>
</root>

@code{

	// now that we fixed the client connection assignment
	// we should reference connections via the Client component
	// rather than the Connection.All
	private LobbyManager LobbyManager => Game.ActiveScene.Components.GetInDescendantsOrSelf<LobbyManager>();
	private IEnumerable<Client> Clients => Game.ActiveScene.Components.GetInDescendants<NetworkManager>().Clients.OrderBy( client => client.ConnectionTime );
	private IEnumerable<Client> PlayerClients => Clients.Where( client => client.Components.Get<Player>() is not null );
	private IEnumerable<Client> SpectatorClients => Clients.Where( client => client.Components.Get<Spectator>() is not null );

	private bool IsReady => LobbyManager.IsReady( Client.Local );

	// TODO: Network
	private void StartGame()
	{
		var gameManager = Scene.Components.GetInDescendantsOrSelf<GameManager>();
		gameManager.Transition( GameManager.State.Round );
	}

	private void ToggleReady()
	{
		LobbyManager.SetIsReady( Client.Local, !IsReady );
	}

	private void BecomePlayer()
	{
		Client.Local.BecomePlayer();
	}

	private void BecomeSpectator()
	{
		Client.Local.BecomeSpectator();
	}


	/// <summary>
	///     the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash()
	{
		return HashCode.Combine( Clients, PlayerClients, SpectatorClients, IsReady );
	}

}
